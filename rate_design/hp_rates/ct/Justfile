# CT heat pump rate design tasks.
# Thin wrapper: sets state defaults, imports shared recipes.
#
# Usage (from rate_design/hp_rates/):
#   just -f ct/Justfile create-bulk-tx-mc-data ct_eversource 2025 --upload
#   just -f ct/Justfile bulk_tx_method=isone_aesc_ptf create-bulk-tx-mc-data ct_ui 2025 --upload
#   just -f ct/Justfile create-bulk-tx-mc-data-all --upload
# Or via dispatch:
#   just s ct create-bulk-tx-mc-data ct_eversource 2025 --upload
#   just s ct create-bulk-tx-mc-data-all --upload

set dotenv-path := "state.env"

state := env_var_or_default('STATE', 'ct')

path_s3_utility_loads := "s3://data.sb/isone/hourly_demand/utilities/"
path_s3_occ863_parquet := "s3://data.sb/eversource/occ863/parquet"
path_s3_mc_root := "s3://data.sb/switchbox/marginal_costs/ct/"
path_local_mc_root := "/ebs/data/switchbox/marginal_costs/ct/"
# month_hour (default), pop_occ863, or pop_isone_zone. See create-dist-mc-data.
dist_mc_method := env_var_or_default('DIST_MC_METHOD', 'month_hour')
# pop_kde (default), month_hour, or isone_aesc_ptf. See create-bulk-tx-mc-data.
bulk_tx_method := env_var_or_default('BULK_TX_METHOD', 'pop_kde')
include_holidays := env_var_or_default('INCLUDE_HOLIDAYS', 'true')
# Calendar for month_hour's weekday/weekend/holiday rule. Empty: year_arg, which is
# right because CAIRO rotates the AMY2018 loads onto the run year's weekdays.
month_hour_calendar_year := env_var_or_default('MONTH_HOUR_CALENDAR_YEAR', '')

import '../Justfile'

# =============================================================================
# FULL FLOW RUN - Prefect pipeline batch + LMI master tables, end to end
#
# One command for the full CT LIDR flow: run the Prefect pipeline batch,
# then build master bills with LMI columns, then master BAT. Stops at the
# first failure (set -euo pipefail), so a broken CAIRO run never reaches
# post-processing.
#
# Defaults to ct_eversource only (state.env lists ct_ui too, but no
# pipeline_ct_ui.yaml yet). When UI exists, override:
#   UTILITY=ct_ui UTILITIES=ct_ui just s ct run-with-lmi ...
# (UI participation rate is not 53%; see lmi_discounts_in_ct.md Section 4.2.)
#
# Setup (once per session): just serve-prefect in a separate terminal (keep it open).
# It sets PREFECT_API_URL in your Prefect profile; no manual export in this terminal.
#
# Then:
#   just s ct run-with-lmi ct_YYYYMMDD_a                    # full batch, all scenarios
#   just s ct run-with-lmi ct_YYYYMMDD_a default             # just the "default" scenario
#
# Re-running with the same batch name resumes: run-pipeline skips any CAIRO
# run that already completed (via its .runs/{name}.path index file), so a
# rerun after a fix only redoes what's missing or failed. *scenarios narrows
# which scenarios are considered at all -- it is not required for a fast
# rerun of the same batch.
#
# LMI (LIDR) columns land only in the all_utilities master-bills table, not
# the per-utility one -- see context/code/orchestration/prefect_pipeline.md.
#
# LMI participation defaults (Eversource CL&P):
#   1.0  -- full take-up among income-eligible households (policy case)
#   0.53 -- observed Eversource LIDR participation (CY2025 enrolled /
#           estimated eligible; see context/domain/charges/lmi_discounts_in_ct.md
#           Section 4.2). Keep 45-60% as a later sensitivity range -- do
# not add those as extra default columns.
run-with-lmi batch *scenarios:
    #!/usr/bin/env bash
    set -euo pipefail
    export UTILITY="${UTILITY:-ct_eversource}"
    export UTILITIES="${UTILITIES:-ct_eversource}"
    just run-pipeline "{{ batch }}" {{ scenarios }}
    just build-master-bills-prefect "{{ batch }}" \
      --calculate-lmi \
      --lmi-fpl-year 2026 \
      --lmi-participation-rates 1.0 0.53 \
      --lmi-participation-mode uniform \
      --lmi-calculation-type monthly \
      --lmi-seed 42 \
      {{ if scenarios != "" { "--scenarios " + scenarios } else { "" } }}
    just build-master-bat-prefect "{{ batch }}" {{ if scenarios != "" { "--scenarios " + scenarios } else { "" } }}

# =============================================================================
# CT-only: bulk transmission marginal costs (ISO-NE AESC PTF)
#
# bulk_tx_method picks the 8760. The annual cost is the AESC 2024 avoided PTF,
# $69/kW-yr in 2024 dollars.
#
#   pop_kde (default)
#     $69 inflated from 2024 dollars to 2026 (--target-dollar-year 2026).
#     2026 is the dollar year of Eversource's distribution MC, the MCOS-2
#     secondary $21.22/kW-yr that create-dist-mc-data allocates, so the two
#     delivery components are in the same dollars. Spread by a month × day-type
#     × hour probability of peak fit with a truncated Gaussian KDE on 2022-2025
#     NE system load,
#     the method Eversource described in OCC-733 and the same four years it
#     used. $/kWh = S × PoP / num_days on the month_hour_calendar_year calendar
#     (default year_arg). --allocation-load utility_zone fits on CT zone load.
#     Applies to ct_eversource and ct_ui.
#
#   month_hour
#     For each month-hour, $/kWh = S × OCC-863 Attachment 2 page 3
#     probability_of_peak / num_days, weekday and weekend-holiday separately.
#     S is $69 inflated from 2024 dollars to --target-dollar-year (2026 here,
#     matching the dollar year of Eversource's distribution MC, as pop_kde
#     does). Days are classified on
#     month_hour_calendar_year (default year_arg), with the same federal-holiday
#     rule as create-dist-mc-data. Every hour is then multiplied by one factor
#     so the 8760 sums to S. The recipe wires Eversource's probability files, so
#     it refuses any utility other than ct_eversource.
#
#   isone_aesc_ptf
#     $69/kW-yr on the top-100 NE system peak hours by exceedance weighting,
#     same methodology as RI. --allocation-load utility_zone uses CT zone load.
#     No CPI. Applies to ct_eversource and ct_ui.
#
# All three write bulk_tx/utility=<utility>/year=<year_arg>/data.parquet and
# append a manifest entry. The pipeline YAML's marginal_costs.bulk_tx.key must
# match the latest entry. Keys: context/code/marginal_costs/mc_provenance_manifest.md.
# Methods: context/methods/marginal_costs/ct_bulk_transmission_marginal_cost.md.
# =============================================================================

ct_bulk_tx_years := "2025"

# Generate bulk TX MC for one CT utility and one year.
#
#   just -f ct/Justfile create-bulk-tx-mc-data ct_eversource 2025
#   just -f ct/Justfile create-bulk-tx-mc-data ct_eversource 2025 --upload
#   just -f ct/Justfile bulk_tx_method=month_hour create-bulk-tx-mc-data ct_eversource 2025
#   just -f ct/Justfile bulk_tx_method=isone_aesc_ptf create-bulk-tx-mc-data ct_eversource 2025
# BULK_TX_METHOD=isone_aesc_ptf just s ct create-bulk-tx-mc-data ct_ui 2025
create-bulk-tx-mc-data utility_arg year_arg *extra_args:
    #!/usr/bin/env bash
    set -euo pipefail
    sets=()
    if [[ -n "{{ month_hour_calendar_year }}" ]]; then
        sets+=(--set "calendar_year={{ month_hour_calendar_year }}")
    fi
    if [[ "{{ include_holidays }}" != "true" ]]; then
        sets+=(--set "include_holidays={{ include_holidays }}")
    fi
    source_args=()
    if [[ "{{ bulk_tx_method }}" == "month_hour" ]]; then
        source_args=(--source 'AESC 2024 avoided PTF ($69/kW-yr, 2024$) x OCC-863 Attachment 2 page 3 probability of peak / num_days, CPI to 2026$, scaled so the 8760 sums to that inflated annual total')
    fi
    just --justfile "{{ justfile() }}" create-mc-data bulk_tx {{ utility_arg }} {{ year_arg }} {{ bulk_tx_method }} \
      --load-year {{ year_arg }} \
      "${sets[@]}" \
      "${source_args[@]}" \
      {{ extra_args }}

# Generate bulk TX MC for all CT utilities across all available years.
#
#   just -f ct/Justfile create-bulk-tx-mc-data-all
# just -f ct/Justfile create-bulk-tx-mc-data-all --upload
create-bulk-tx-mc-data-all *extra_args:
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{ path_repo }}
    mapfile -t utils < <(uv run python {{ path_repo }}/utils/data_prep/marginal_costs/run_allocation.py \
      --config {{ path_config }}/marginal_costs/allocation.yaml \
      --component bulk_tx \
      --variant {{ bulk_tx_method }} \
      --list-utilities)
    for utility in "${utils[@]}"; do
        for year in {{ ct_bulk_tx_years }}; do
            echo ">> Generating ISO-NE bulk TX MC: utility=${utility} year=${year} method={{ bulk_tx_method }}" >&2
            just --justfile "{{ justfile() }}" \
              bulk_tx_method="{{ bulk_tx_method }}" \
              include_holidays="{{ include_holidays }}" \
              month_hour_calendar_year="{{ month_hour_calendar_year }}" \
              create-bulk-tx-mc-data "${utility}" "${year}" {{ extra_args }}
        done
    done
    echo ">> Done: all CT bulk TX MC (${#utils[@]} utilities × $(echo {{ ct_bulk_tx_years }} | wc -w) years)" >&2

# =============================================================================
# CT-only: distribution + sub-transmission marginal costs (Eversource CL&P)
#
# dist_mc_method picks one of three 8760s, in order of preference:
#
#   month_hour (default)
#     OCC-863 Attachment 2 secondary month-hour $/kWh tables. Days are
#     classified on month_hour_calendar_year's calendar (default year_arg):
#     Saturday and Sunday take the weekend table, and federal holidays do too
#     unless include_holidays=false. Every hour is then multiplied by one
#     factor so the 8760 sums to the $/kW-yr in ct_marginal_costs_<year>.csv
#     ($21.22 for 2025, the same scalar and dollar-year rule as the PoP
#     methods). The 8760 is stamped as year_arg by position, on the timestamps
#     and the Hive partition.
#
#   pop_occ863
#     $21.22/kW-yr (ct_marginal_costs_<year>.csv) allocated over the top
#     upstream_hours of Eversource's OCC-863 Attachment 3 substation load.
#
#   pop_isone_zone (oldest, not preferred)
#     The same $21.22/kW-yr over the top hours of ISO-NE CT zone load.
#
# All three write dist_and_sub_tx/utility=ct_eversource/year=<year_arg>/
# data.parquet and append an entry to manifest.yaml beside it; the latest
# entry's key says which method the current file came from. The pipeline
# YAML's marginal_costs.dist_and_sub_tx.key must match it. Keys are listed in
# context/code/marginal_costs/mc_provenance_manifest.md.
#
# Both PoP methods pass --target-dollar-year 2026, the MCOS study's own dollar
# year, so $21.22 is allocated as filed with no CPI adjustment. 2026 is not rate
# year 1 (Jul 2027 - Jun 2028); keeping the filed value is a modeling choice.
# See context/methods/marginal_costs/ct_eversource_dist_mc_methodology.md.
#
# CL&P's MCOS-2 covers ct_eversource only; ct_ui has no MCOS-derived value yet
# (see the methodology doc's open questions), so this recipe does not loop
# over utilities. create-bulk-tx-mc-data-all does. Its default (pop_kde) covers
# both utilities; bulk_tx_method=month_hour refuses anything other than
# ct_eversource.
# =============================================================================

# Generate dist+sub-tx MC for ct_eversource and one year.
#
#   just -f ct/Justfile create-dist-mc-data 2025 --upload
#   just -f ct/Justfile include_holidays=false create-dist-mc-data 2025 --upload
#   just -f ct/Justfile dist_mc_method=pop_occ863 create-dist-mc-data 2025 --upload
#   just -f ct/Justfile dist_mc_method=pop_isone_zone create-dist-mc-data 2025 --upload
# DIST_MC_METHOD=pop_occ863 just s ct create-dist-mc-data 2025 --upload
create-dist-mc-data year_arg *extra_args:
    #!/usr/bin/env bash
    set -euo pipefail
    pop_scalar_source='PURA Docket 26-05-10, MCOS-2 Table 3 secondary ($20.17/kW-yr, 2026$) x OCC-863 Attachment 2 secondary loss factor = $21.22/kW-yr'
    sets=()
    if [[ -n "{{ month_hour_calendar_year }}" ]]; then
        sets+=(--set "calendar_year={{ month_hour_calendar_year }}")
    fi
    if [[ "{{ include_holidays }}" != "true" ]]; then
        sets+=(--set "include_holidays={{ include_holidays }}")
    fi
    case "{{ dist_mc_method }}" in
      month_hour)
        source_arg='PURA Docket 26-05-10, OCC-863 Attachment 2, secondary month-hour $/kWh (weekday; weekend and holiday), scaled uniformly to the MCOS-2 secondary $/kW-yr'
        ;;
      pop_occ863)
        source_arg="${pop_scalar_source}; load: OCC-863 Attachment 3 page 2 distribution-substation load"
        ;;
      pop_isone_zone)
        source_arg="${pop_scalar_source}; load: ISO-NE CT zone hourly demand"
        ;;
      *)
        echo "dist_mc_method must be month_hour, pop_occ863, or pop_isone_zone (got '{{ dist_mc_method }}')" >&2
        exit 1
        ;;
    esac
    echo ">> CT dist MC: method={{ dist_mc_method }} year={{ year_arg }} -> dist_and_sub_tx/" >&2
    just --justfile "{{ justfile() }}" create-mc-data dist_and_sub_tx ct_eversource {{ year_arg }} {{ dist_mc_method }} \
      --load-year {{ year_arg }} \
      --source "${source_arg}" \
      --path-local-base "{{ path_local_mc_root }}dist_and_sub_tx/" \
      "${sets[@]}" \
      {{ extra_args }}

# =============================================================================
# CT-only: zero-filled supply energy and capacity 8760s (zero.parquet)
#
# CT has no real supply MC yet, so delivery and supply runs both read these
# placeholders. Each write appends a key: zero entry to the partition's
# manifest.yaml.
#
#   just -f ct/Justfile create-zero-supply-mc-data ct_eversource 2025 --upload
# =============================================================================

create-zero-supply-mc-data utility_arg year_arg *extra_args:
    cd {{ path_repo }} && uv run python {{ path_repo }}/utils/data_prep/marginal_costs/supply/generate_zero_supply_mc.py \
      --utility {{ utility_arg }} \
      --year {{ year_arg }} \
      --output-s3-base "{{ path_s3_mc_root }}supply/" \
      {{ extra_args }}

# =============================================================================
# CT-only: gas tariff fetch
#
# Fetches URDB v7 JSONs for all CT gas LDCs (CNG, Yankee, SCG, Norwich muni)
# from RateAcuity per rateacuity_tariffs.yaml. See
# context/code/data/ct_tariff_fetch.md for scope, schedule coverage, and
# evidence. Ticket scope is fetch only — null_gas_tariff.json must still be
# copied in manually and ensure-gas-tariff-envelope run afterward.
# =============================================================================

# just -f ct/Justfile fetch-gas-tariffs
fetch-gas-tariffs:
    uv run python {{ path_repo }}/utils/pre/fetch_gas_tariffs_rateacuity.py "{{ path_rateacuity_yaml }}" "{{ path_tariffs_gas }}"
