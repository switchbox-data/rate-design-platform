# CT heat pump rate design tasks.
# Thin wrapper: sets state defaults, imports shared recipes.
#
# Usage (from rate_design/hp_rates/):
#   just -f ct/Justfile create-bulk-tx-mc-data ct_eversource 2025 --upload
#   just -f ct/Justfile create-bulk-tx-mc-data ct_ui 2025 --upload
#   just -f ct/Justfile create-bulk-tx-mc-data-all --upload
# Or via dispatch:
#   just s ct create-bulk-tx-mc-data ct_eversource 2025 --upload
#   just s ct create-bulk-tx-mc-data-all --upload

set dotenv-path := "state.env"

state := env_var_or_default('STATE', 'ct')

path_s3_utility_loads := "s3://data.sb/isone/hourly_demand/utilities/"
path_s3_occ863_parquet := "s3://data.sb/switchbox/sources/ct/eversource/docket-26-05-10/occ-863/parquet"
path_s3_dist_mc_root := "s3://data.sb/switchbox/marginal_costs/ct/"
path_local_dist_mc_root := "/ebs/data/switchbox/marginal_costs/ct/"
# month_hour (default), pop_occ863, or pop_isone_zone. See create-dist-mc-data.
dist_mc_method := env_var_or_default('DIST_MC_METHOD', 'month_hour')
include_holidays := env_var_or_default('INCLUDE_HOLIDAYS', 'true')

import '../Justfile'

# =============================================================================
# FULL FLOW RUN - Prefect pipeline batch + LMI master tables, end to end
#
# One command for the full CT LIDR flow: run the Prefect pipeline batch,
# then build master bills with LMI columns, then master BAT. Stops at the
# first failure (set -euo pipefail), so a broken CAIRO run never reaches
# post-processing.
#
# Defaults to ct_eversource only (state.env lists ct_ui too, but no
# pipeline_ct_ui.yaml yet). When UI exists, override:
#   UTILITY=ct_ui UTILITIES=ct_ui just s ct run-with-lmi ...
# (UI participation rate is not 53%; see lmi_discounts_in_ct.md Section 4.2.)
#
# Setup (once per session): just serve-prefect in a separate terminal (keep it open).
# It sets PREFECT_API_URL in your Prefect profile; no manual export in this terminal.
#
# Then:
#   just s ct run-with-lmi ct_YYYYMMDD_a                    # full batch, all scenarios
#   just s ct run-with-lmi ct_YYYYMMDD_a default             # just the "default" scenario
#
# Re-running with the same batch name resumes: run-pipeline skips any CAIRO
# run that already completed (via its .runs/{name}.path index file), so a
# rerun after a fix only redoes what's missing or failed. *scenarios narrows
# which scenarios are considered at all -- it is not required for a fast
# rerun of the same batch.
#
# LMI (LIDR) columns land only in the all_utilities master-bills table, not
# the per-utility one -- see context/code/orchestration/prefect_pipeline.md.
#
# LMI participation defaults (Eversource CL&P):
#   1.0  -- full take-up among income-eligible households (policy case)
#   0.53 -- observed Eversource LIDR participation (CY2025 enrolled /
#           estimated eligible; see context/domain/charges/lmi_discounts_in_ct.md
#           Section 4.2). Keep 45-60% as a later sensitivity range -- do
# not add those as extra default columns.
run-with-lmi batch *scenarios:
    #!/usr/bin/env bash
    set -euo pipefail
    export UTILITY="${UTILITY:-ct_eversource}"
    export UTILITIES="${UTILITIES:-ct_eversource}"
    just run-pipeline "{{ batch }}" {{ scenarios }}
    just build-master-bills-prefect "{{ batch }}" \
      --calculate-lmi \
      --lmi-fpl-year 2026 \
      --lmi-participation-rates 1.0 0.53 \
      --lmi-participation-mode uniform \
      --lmi-calculation-type monthly \
      --lmi-seed 42 \
      {{ if scenarios != "" { "--scenarios " + scenarios } else { "" } }}
    just build-master-bat-prefect "{{ batch }}" {{ if scenarios != "" { "--scenarios " + scenarios } else { "" } }}

# =============================================================================
# CT-only: bulk transmission marginal costs (ISO-NE AESC PTF)
#
# Uses AESC 2024 avoided PTF cost ($69/kW-yr) allocated to the top-100 NE
# system peak hours via exceedance weighting — same methodology as RI.
# Outputs land at s3://data.sb/switchbox/marginal_costs/ct/bulk_tx/.
# =============================================================================

ct_bulk_tx_years := "2025"

# Generate bulk TX MC for one CT utility and one year.
#
#   just -f ct/Justfile create-bulk-tx-mc-data ct_eversource 2025
# just -f ct/Justfile create-bulk-tx-mc-data ct_eversource 2025 --upload
create-bulk-tx-mc-data utility_arg year_arg *extra_args:
    cd {{ path_repo }} && uv run python {{ path_repo }}/utils/data_prep/marginal_costs/generate_bulk_tx_mc.py \
      --iso isone \
      --utility {{ utility_arg }} \
      --year {{ year_arg }} \
      --load-year {{ year_arg }} \
      {{ extra_args }}

# Generate bulk TX MC for all CT utilities across all available years.
#
#   just -f ct/Justfile create-bulk-tx-mc-data-all
# just -f ct/Justfile create-bulk-tx-mc-data-all --upload
create-bulk-tx-mc-data-all *extra_args:
    #!/usr/bin/env bash
    set -euo pipefail
    IFS=',' read -ra utils <<< "{{ utilities }}"
    for utility in "${utils[@]}"; do
        for year in {{ ct_bulk_tx_years }}; do
            echo ">> Generating ISO-NE bulk TX MC: utility=${utility} year=${year}" >&2
            cd {{ path_repo }} && uv run python {{ path_repo }}/utils/data_prep/marginal_costs/generate_bulk_tx_mc.py \
              --iso isone \
              --utility "${utility}" \
              --year "${year}" \
              --load-year "${year}" \
              {{ extra_args }}
        done
    done
    echo ">> Done: all CT bulk TX MC (${#utils[@]} utilities × $(echo {{ ct_bulk_tx_years }} | wc -w) years)" >&2

# =============================================================================
# CT-only: distribution + sub-transmission marginal costs (Eversource CL&P)
#
# dist_mc_method picks one of three 8760s, in order of preference:
#
#   month_hour (default)
#     OCC-863 Attachment 2 secondary month-hour $/kWh tables, expanded onto
#     year_arg's calendar. Saturday and Sunday take the weekend table, and
#     federal holidays do too unless include_holidays=false. year_arg is
#     stamped on the timestamps and the Hive partition.
#     -> dist_and_sub_tx_eversource_derived/
#
#   pop_occ863
#     $21.22/kW-yr (ct_marginal_costs_<year>.csv) allocated over the top
#     upstream_hours of Eversource's OCC-863 Attachment 3 substation load.
#     -> dist_and_sub_tx_occ863/
#
#   pop_isone_zone (oldest, not preferred)
#     The same $21.22/kW-yr over the top hours of ISO-NE CT zone load.
#     -> dist_and_sub_tx/ (also holds the older CPI-deflated $20.17 parquet
#        at year=2025; uploading 2025 replaces it)
#
# Both PoP methods pass --target-dollar-year 2026: the analysis is rate year 1,
# in the filing's 2026 dollars, so $21.22 is allocated with no CPI adjustment.
# See context/methods/marginal_costs/ct_eversource_dist_mc_methodology.md.
#
# CL&P's MCOS-2 covers ct_eversource only; ct_ui has no MCOS-derived value yet
# (see the methodology doc's open questions), so this recipe does not loop
# over both CT utilities the way create-bulk-tx-mc-data-all does.
# =============================================================================

# Generate dist+sub-tx MC for ct_eversource and one year.
#
#   just -f ct/Justfile create-dist-mc-data 2025 --upload
#   just -f ct/Justfile include_holidays=false create-dist-mc-data 2025 --upload
#   just -f ct/Justfile dist_mc_method=pop_occ863 create-dist-mc-data 2025 --upload
#   just -f ct/Justfile dist_mc_method=pop_isone_zone create-dist-mc-data 2025 --upload
# DIST_MC_METHOD=pop_occ863 just s ct create-dist-mc-data 2025 --upload
create-dist-mc-data year_arg *extra_args:
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{ dist_mc_method }}" in
      month_hour)
        dataset=dist_and_sub_tx_eversource_derived
        method_args=(
          --method month_hour
          --path-weekday-mc "{{ path_s3_occ863_parquet }}/month_hour_marginal_costs_weekday_secondary.parquet"
          --path-weekend-mc "{{ path_s3_occ863_parquet }}/month_hour_marginal_costs_weekend_holidays_secondary.parquet"
          --include-holidays "{{ include_holidays }}"
        )
        ;;
      pop_occ863)
        dataset=dist_and_sub_tx_occ863
        method_args=(--method pop --path-utility-load "{{ path_s3_occ863_parquet }}/system_load.parquet")
        ;;
      pop_isone_zone)
        dataset=dist_and_sub_tx
        method_args=(--method pop --utility-load-s3-base "{{ path_s3_utility_loads }}")
        ;;
      *)
        echo "dist_mc_method must be month_hour, pop_occ863, or pop_isone_zone (got '{{ dist_mc_method }}')" >&2
        exit 1
        ;;
    esac
    if [[ "${method_args[1]}" == "pop" ]]; then
      method_args+=(
        --load-year "{{ year_arg }}"
        --target-dollar-year 2026
        --mc-table-path "{{ path_config }}/marginal_costs/ct_marginal_costs_{{ year_arg }}.csv"
        --n-hours "{{ upstream_hours }}"
      )
    fi
    echo ">> CT dist MC: method={{ dist_mc_method }} year={{ year_arg }} -> ${dataset}/" >&2
    cd {{ path_repo }}
    uv run python utils/data_prep/marginal_costs/generate_utility_tx_dx_mc.py \
      --state CT \
      --utility ct_eversource \
      --year {{ year_arg }} \
      --output-s3-base "{{ path_s3_dist_mc_root }}${dataset}/" \
      --path-local-output-base "{{ path_local_dist_mc_root }}${dataset}/" \
      "${method_args[@]}" \
      {{ extra_args }}

# =============================================================================
# CT-only: OCC-863 Attachment 3 → hourly system load and monthly peaks (MW)
#
# Page 2 is the hourly distribution-substation load for 2022–2025 (2024 keeps
# the leap day). Page 1 is each month's maximum MW. Writes
# system_load.parquet and system_monthly_peak_mw.parquet. See
# context/code/data/ct_occ863_system_load.md.
#
#   just -f ct/Justfile convert-occ863-system-load <path_xlsx> <path_output_dir>
# =============================================================================

convert-occ863-system-load path_xlsx path_output_dir:
    cd {{ path_repo }} && uv run python {{ path_repo }}/utils/data_prep/marginal_costs/convert_ct_occ863_system_load.py \
      --path-xlsx {{ path_xlsx }} \
      --path-output-dir {{ path_output_dir }}

# =============================================================================
# CT-only: OCC-863 Attachment 4 → 2025 hourly load for Rates 1, 5, and 7
#
# Interval Ending EST is shifted back one hour, then mapped from Eastern
# Standard Time onto local wall-clock time so the stamps match system_load.
# Writes rate_1_load.parquet, rate_5_load.parquet, and rate_7_load.parquet
# with columns timestamp, load_kw, load_mw. See
# context/code/data/ct_occ863_system_load.md.
#
#   just -f ct/Justfile convert-occ863-rate-class-load <path_xlsx> <path_output_dir>
# =============================================================================

convert-occ863-rate-class-load path_xlsx path_output_dir:
    cd {{ path_repo }} && uv run python {{ path_repo }}/utils/data_prep/marginal_costs/convert_ct_occ863_rate_class_load.py \
      --path-xlsx {{ path_xlsx }} \
      --path-output-dir {{ path_output_dir }}

# =============================================================================
# CT-only: OCC-863 Attachment 2 → month-hour marginal costs
#
# voltage is secondary (page 1) or primary (page 2). Writes the all-day-types,
# weekday, and weekend-and-holiday matrices. Each row is one month (1–12) and
# hour (0–23), with that month's "No Days" count and mc_total_per_kwh. See
# context/code/data/ct_occ863_system_load.md.
#
#   just -f ct/Justfile convert-occ863-month-hour-mc <path_xlsx> <path_output_dir> secondary
# =============================================================================

convert-occ863-month-hour-mc path_xlsx path_output_dir voltage:
    cd {{ path_repo }} && uv run python {{ path_repo }}/utils/data_prep/marginal_costs/convert_ct_occ863_month_hour_mc.py \
      --path-xlsx {{ path_xlsx }} \
      --path-output-dir {{ path_output_dir }} \
      --voltage {{ voltage }}

# =============================================================================
# CT-only: gas tariff fetch
#
# Fetches URDB v7 JSONs for all CT gas LDCs (CNG, Yankee, SCG, Norwich muni)
# from RateAcuity per rateacuity_tariffs.yaml. See
# context/code/data/ct_tariff_fetch.md for scope, schedule coverage, and
# evidence. Ticket scope is fetch only — null_gas_tariff.json must still be
# copied in manually and ensure-gas-tariff-envelope run afterward.
# =============================================================================

# just -f ct/Justfile fetch-gas-tariffs
fetch-gas-tariffs:
    uv run python {{ path_repo }}/utils/pre/fetch_gas_tariffs_rateacuity.py "{{ path_rateacuity_yaml }}" "{{ path_tariffs_gas }}"
